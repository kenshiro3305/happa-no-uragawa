# ==============================================================================
# 葉っぱの裏側 — Instagram自動投稿の設定
#
# 使い方:
#   1) このファイルを .env.local という名前でコピーする
#        cp .env.example .env.local
#   2) 下の値を埋める
#   3) bash setup.sh を実行する
#
# ★ .env.local は .gitignore に入っているので GitHub には上がりません。
# ★ 値をチャットに貼らないでください。
# ==============================================================================

# --- Meta（Instagram）--------------------------------------------------------
# developers.facebook.com のアプリ →「Instagram」→
# 「API setup with Instagram login」で happa_no_uragawa を接続し、
# Generate token を押して取得する。
#
# ★ happa_no_uragawa 用のトークンを生成してください。

# 同じ画面に表示される Instagram のユーザー番号（数字）
IG_USER_ID=

# IGAA... で始まる長い文字列
IG_ACCESS_TOKEN=

# --- 必須：トークンの自動延長 -------------------------------------------------
# GitHubの Personal access token（対象リポジトリの Secrets: write 権限）。
# IG_USER_ID / IG_ACCESS_TOKEN / GH_PAT は repository Secrets に登録します。
# production に同名のトークンを置くと repository の更新より優先されるので、
# setup.sh と refresh-token.yml の保存先を確認してください。
#
# ★ 空の場合はトークン延長ワークフローが失敗し、延長は実行されません。
#   延長とSecretsへの書き戻しが成功した場合に有効期限が更新されます。
#   失効済みのトークンは再取得が必要です。
GH_PAT=

# --- 必須：失敗通知のメール ---------------------------------------------------
# 通知先とSMTP認証情報。SMTP_PASS はこの運用専用のアプリパスワードです。
DIGEST_TO=
SMTP_USER=
SMTP_PASS=

# 任意。未設定の場合は smtp.gmail.com:587 を使います。
SMTP_HOST=
SMTP_PORT=
