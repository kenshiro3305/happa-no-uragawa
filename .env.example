# ==============================================================================
# 葉っぱの裏側 — Instagram自動投稿の設定
#
# 使い方:
#   1) このファイルを .env.local という名前でコピーする
#        cp .env.example .env.local
#   2) 下の値を埋める
#   3) bash setup.sh を実行する
#
# ★ .env.local は .gitignore に入っているので GitHub には上がりません。
# ★ 値をチャットに貼らないでください。
# ==============================================================================

# --- Meta（Instagram）--------------------------------------------------------
# developers.facebook.com のアプリ →「Instagram」→
# 「API setup with Instagram login」で happa_no_uragawa を接続し、
# Generate token を押して取得する。
#
# ★ 既存の hitori-jidoka-lab-monitor で使っているトークンとは別物です。
#   アカウントごとにトークンが分かれるため、happa_no_uragawa 用を生成してください。

# 同じ画面に表示される Instagram のユーザー番号（数字）
IG_USER_ID=

# IGAA... で始まる長い文字列
IG_ACCESS_TOKEN=

# --- 任意：トークンの自動延長 -------------------------------------------------
# GitHubの Personal access token（このリポジトリのSecretsへの書き込み権限）。
# 登録するとトークンが毎日60日先へ延長され、期限切れで止まらなくなります。
#
# ★ 空のままでも投稿は動きますが、60日後に無言で停止します。
#   省略しないことを強く勧めます。
GH_PAT=
